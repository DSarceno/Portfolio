def _rk4(f, y0: np.ndarray, t: np.ndarray) -> np.ndarray:
    """Fixed-step classic 4th-order Runge-Kutta integrator."""
    y = np.empty((t.size, y0.size), dtype=float)
    y[0] = y0
    for i in range(t.size - 1):
        dt = t[i + 1] - t[i]
        k1 = f(t[i], y[i])
        k2 = f(t[i] + 0.5 * dt, y[i] + 0.5 * dt * k1)
        k3 = f(t[i] + 0.5 * dt, y[i] + 0.5 * dt * k2)
        k4 = f(t[i] + dt, y[i] + dt * k3)
        y[i + 1] = y[i] + (dt / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4)
    return y


def _euler(f, y0: np.ndarray, t: np.ndarray) -> np.ndarray:
    """Fixed-step explicit Euler integrator."""
    y = np.empty((t.size, y0.size), dtype=float)
    y[0] = y0
    for i in range(t.size - 1):
        dt = t[i + 1] - t[i]
        y[i + 1] = y[i] + dt * f(t[i], y[i])
    return y


